# Local development (never put private keys in NEXT_PUBLIC_* variables)
APP_ENV=private-local
NEXT_PUBLIC_NETWORK_ID=1337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_PAID_MODE_ENABLED=true
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PPL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WC_PROJECT_ID=local-development-only

# Server-side RPCs
POLYGON_RPC_URL=
POLYGON_AMOY_RPC_URL=
BLOCK_SCAN_FROM_BLOCK=

# Deployment-only, local placeholder only; do not commit a value
DEPLOYER_PRIVATE_KEY=
# Legacy alias accepted by Hardhat config; prefer DEPLOYER_PRIVATE_KEY.
PRIVATE_KEY=
VRF_COORDINATOR=
VRF_SUBSCRIPTION_ID=
VRF_KEY_HASH=
VRF_REQUEST_CONFIRMATIONS=3
VRF_CALLBACK_GAS_LIMIT=2000000
INITIAL_MATIC_LIQUIDITY=50
INITIAL_TOKEN_LIQUIDITY=90000
