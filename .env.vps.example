# Internet-facing no-money VPS template. Copy to a root-owned runtime file;
# never commit the populated file.
APP_ENV=public-readonly
NODE_ENV=production
APP_DOMAIN=example.com

# Public/non-secret build configuration. Paid mode remains disabled until a
# separately approved, funded public-chain deployment exists.
NEXT_PUBLIC_NETWORK_ID=137
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PPL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_PAID_MODE_ENABLED=false
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional server-only read configuration. Never put credentials in
# NEXT_PUBLIC_* variables.
POLYGON_RPC_URL=
BLOCK_SCAN_FROM_BLOCK=

# Forbidden on the web VPS: DEPLOYER_PRIVATE_KEY, PRIVATE_KEY, owner/admin,
# treasury, dev-fee, mnemonic, and VRF subscription-owner credentials.
